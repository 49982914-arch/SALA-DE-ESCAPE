<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - La Tormenta Final</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SALA_DE_ESCAPE.styles.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
        }
        .navbar {
            background: linear-gradient(90deg, #0f3460 0%, #1a1a2e 100%) !important;
            border-bottom: 2px solid #00d4ff !important;
        }
        .navbar-brand {
            color: #00d4ff !important;
            font-weight: bold;
            font-size: 1.3rem;
            text-shadow: 0 0 10px #00d4ff;
        }
        .nav-link {
            color: #ccc !important;
            transition: color 0.3s;
        }
        .nav-link:hover {
            color: #00d4ff !important;
        }
        footer {
            background-color: rgba(15, 52, 96, 0.8) !important;
            border-top: 2px solid #00d4ff !important;
            color: #aaa !important;
        }
    </style>
</head>
<body>
    <header></header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-5 py-4">
        <div class="container text-center">
            <p style="margin: 0; color: #aaa;">
                🎮 La Tormenta Final - ASP.NET Core MVC | 
                <a href="@Url.Action("Index", "Home")" style="color: #00d4ff; text-decoration: none;">Inicio</a>
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
