@{
    ViewData["Title"] = "Sala 1 - El secreto de las letras";
}

<audio id="audioTormenta" autoplay loop>
    <source src="/images/tormenta.m4a" type="audio/mp4">
</audio>

<div id="starryBackground" class="starry-background"></div>

<div class="sala1-cosmic-container">
    <div class="sala1-epic-header">
        <h1 class="sala1-title">⭐ EL SECRETO DE LAS LETRAS ⭐</h1>
        <p class="sala1-subtitle">En el principio del universo, todo comenzó con un código oculto.</p>
    </div>

    <div class="sala1-characters-section">
        <div class="character-left">
            <img src="/images/skin galaxy 2026.png" alt="Galaxy" class="character-image">
            <div class="speech-bubble speech-bubble-left">
                <p class="speech-text">El origen de todo está escrito en las letras...</p>
            </div>
        </div>

        <div class="character-right">
            <img src="/images/aura skin 2026 sde.jpg" alt="Aura" class="character-image">
            <div class="speech-bubble speech-bubble-right">
                <p class="speech-text">Suma los valores de las que brillan y revela el secreto.</p>
            </div>
        </div>
    </div>

    <div class="sala1-epic-text-container">
        <p id="sala1TypingText" class="sala1-typing-text"></p>
    </div>

    <div class="sala1-letters-panel">
        <div id="lettersUniverse" class="letters-universe"></div>
    </div>

    <div class="sala1-pista-container">
        <button type="button" id="revealHintBtn" class="reveal-hint-btn">💡 Revelar pista</button>
        <p id="revealHintText" class="reveal-hint-text" style="display: none;"></p>
    </div>

    <div class="sala1-input-section">
        <form method="post" action="@Url.Action("Sala1", "Home")" class="form-cosmic">
            <label for="respuestaInput" class="input-label">🔐 CANALIZAR ENERGÍA:</label>
            <input type="text" name="respuesta" id="respuestaInput" class="cosmic-input" placeholder="000" maxlength="10" autocomplete="off">
            <button type="submit" class="submit-btn-cosmic">⚡ DESCIFRAR CÓDIGO ⚡</button>
        </form>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="alert-error">❌ @ViewBag.Error</div>
        }

        @if (ViewBag.Intentos > 0)
        {
            <p class="attempts-counter">📊 Intentos: <span class="attempts-number">@ViewBag.Intentos</span></p>
        }
    </div>
</div>
