@{
    ViewData["Title"] = "La Historia de Midas";
}

<div class="video-midas-container">
    <video id="videoMidas" class="video-midas-player" autoplay muted playsinline>
        <source src="/images/midas.mp4" type="video/mp4">
    </video>

    <div class="video-midas-overlay-text">
        <p class="video-midas-title">La historia de Midas...</p>
    </div>

    <a href="@Url.Action("Mapa", "Home")" class="video-midas-skip-btn">Saltar ➡️</a>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const video = document.getElementById('videoMidas');
        video.load();
        video.play().catch(function(e) { console.log(e); });
        video.addEventListener('ended', function() {
            window.location.href = '/Home/Mapa';
        });
    });
</script>
