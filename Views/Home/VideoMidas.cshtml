@{
    ViewData["Title"] = "La Historia de Midas";
}

<div class="video-midas-container">
    <video id="videoMidas" class="video-midas-player" playsinline>
        <source src="/images/midas.mp4" type="video/mp4">
    </video>

    <div id="playOverlay" style="position:absolute; top:0; left:0; width:100%; height:100%; display:flex; justify-content:center; align-items:center; z-index:10001; cursor:pointer;" onclick="iniciarVideo()">
        <div style="text-align:center;">
            <p style="color:#FFD700; font-size:2rem; font-weight:bold;">La historia de Midas...</p>
            <p style="color:#fff; font-size:1.2rem; margin-top:20px;">▶ Click para reproducir</p>
        </div>
    </div>

    <a href="@Url.Action("Mapa", "Home")" class="video-midas-skip-btn">Saltar ➡️</a>
</div>

<script>
    function iniciarVideo() {
        var overlay = document.getElementById('playOverlay');
        var video = document.getElementById('videoMidas');
        overlay.style.display = 'none';
        video.play();
        video.addEventListener('ended', function() {
            window.location.href = '/Home/Mapa';
        });
    }
</script>