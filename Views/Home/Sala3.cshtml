@{
    ViewData["Title"] = "Sala 3 - Jonesy & Bananoide - La Tormenta Final";
}

<div class="row justify-content-center" style="min-height: 90vh; background: linear-gradient(135deg, #1a2a1a 0%, #1a1a2a 100%); padding: 30px 0;">
    <div class="col-md-10">
        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="color: #00d4ff; font-weight: bold;">🧬 Jonesy & Bananoide</h2>
                <p style="color: #aaa; margin: 5px 0;">Sala 3 de 4 - Encuentra los aliados correctos</p>
            </div>
            <div style="background-color: #0f3460; padding: 15px 20px; border-radius: 8px;">
                <p style="color: #00d4ff; font-weight: bold; margin: 0;">⚡ PROGRESO</p>
                <div class="progress mt-2" style="height: 8px; background-color: #1a1a2e;">
                    <div class="progress-bar" role="progressbar" style="width: 75%; background-color: #00d4ff;"></div>
                </div>
            </div>
        </div>

        <!-- Tarjeta Principal -->
        <div class="card shadow-lg mb-4" style="background: linear-gradient(135deg, #0f3460 0%, #1a0f3f 100%); border: 2px solid #00d4ff; border-radius: 15px; box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);">
            <div class="card-body p-5">
                <!-- Instrucciones -->
                <div style="margin-bottom: 30px;">
                    <p style="color: #00d4ff; font-size: 1.2rem; font-weight: bold; text-align: center; margin-bottom: 15px;">
                        👥 ¡Selecciona los 2 aliados correctos!
                    </p>
                    <p style="color: #ccc; font-size: 1.05rem; text-align: center;">
                        Debes encontrar a <strong style="color: #e94560;">Jonesy</strong> y al <strong style="color: #e94560;">Bananoide</strong> entre 6 skins.<br>
                        Clickea solo en los correctos, o deberás reintentar.
                    </p>
                    <div style="background-color: #0f2440; padding: 15px; border-radius: 8px; margin-top: 15px; border-left: 4px solid #00d4ff;">
                        <p style="color: #00d4ff; margin: 0; font-weight: bold;">
                            Seleccionados: <span id="seleccionados" style="color: #e94560; font-size: 1.3rem;">0</span> / 2
                        </p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;" id="errorAlert">
                        ❌ @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Grid de Skins -->
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px;">
                    <!-- Jonesy (Correcto) -->
                    <div class="skin-card" data-skin="jonesy" data-correcto="true">
                        <div style="background-color: #1a1a2e; border: 3px solid #00d4ff; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <p style="font-size: 2.5rem; margin: 0 0 10px 0;">🧑</p>
                            <p style="color: #00d4ff; font-weight: bold; margin: 0; font-size: 1rem;">JONESY</p>
                        </div>
                    </div>

                    <!-- Ramirez (Incorrecto) -->
                    <div class="skin-card" data-skin="ramirez" data-correcto="false">
                        <div style="background-color: #1a1a2e; border: 3px solid #666; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <p style="font-size: 2.5rem; margin: 0 0 10px 0;">👩</p>
                            <p style="color: #ccc; font-weight: bold; margin: 0; font-size: 1rem;">RAMIREZ</p>
                        </div>
                    </div>

                    <!-- Brutus (Incorrecto) -->
                    <div class="skin-card" data-skin="brutus" data-correcto="false">
                        <div style="background-color: #1a1a2e; border: 3px solid #666; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <p style="font-size: 2.5rem; margin: 0 0 10px 0;">💪</p>
                            <p style="color: #ccc; font-weight: bold; margin: 0; font-size: 1rem;">BRUTUS</p>
                        </div>
                    </div>

                    <!-- Meowscles (Incorrecto) -->
                    <div class="skin-card" data-skin="meowscles" data-correcto="false">
                        <div style="background-color: #1a1a2e; border: 3px solid #666; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <p style="font-size: 2.5rem; margin: 0 0 10px 0;">🐱</p>
                            <p style="color: #ccc; font-weight: bold; margin: 0; font-size: 1rem;">MEOWSCLES</p>
                        </div>
                    </div>

                    <!-- Bananoide (Correcto) -->
                    <div class="skin-card" data-skin="bananoide" data-correcto="true">
                        <div style="background-color: #1a1a2e; border: 3px solid #00d4ff; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <p style="font-size: 2.5rem; margin: 0 0 10px 0;">🍌</p>
                            <p style="color: #00d4ff; font-weight: bold; margin: 0; font-size: 1rem;">BANANOIDE</p>
                        </div>
                    </div>

                    <!-- Skeletortilla (Incorrecto) -->
                    <div class="skin-card" data-skin="skeletortilla" data-correcto="false">
                        <div style="background-color: #1a1a2e; border: 3px solid #666; border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <p style="font-size: 2.5rem; margin: 0 0 10px 0;">💀</p>
                            <p style="color: #ccc; font-weight: bold; margin: 0; font-size: 1rem;">SKULL SQUAD</p>
                        </div>
                    </div>
                </div>

                <!-- Formulario oculto -->
                <form method="post" action="@Url.Action("Sala3", "Home")" id="sala3Form" style="display: none;">
                    <input type="hidden" name="respuesta" value="aliados">
                </form>

                @if (ViewBag.Intentos > 0)
                {
                    <p style="color: #00d4ff; margin-top: 20px; text-align: center;">
                        📊 Intentos realizados: <strong>@ViewBag.Intentos</strong>
                    </p>
                }
            </div>
        </div>

        <!-- Pista -->
        <div style="background-color: #0f3460; border-left: 4px solid #e94560; padding: 20px; border-radius: 8px;">
            <p style="color: #00d4ff; font-weight: bold; margin: 0 0 10px 0;">💡 PISTA:</p>
            <p style="color: #ccc; margin: 0;">
                Busca a Jonesy (el soldado clásico) y al Bananoide (el fruto que habla). Solo dos son los aliados correctos.
            </p>
        </div>
    </div>
</div>

<style>
    .skin-card div:hover {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(0, 212, 255, 0.5);
    }

    .skin-card.seleccionado div {
        border-color: #e94560 !important;
        background-color: #2a1a2a !important;
        box-shadow: 0 0 20px rgba(233, 69, 96, 0.6);
    }
</style>

<script>
    let seleccionCount = 0;
    const seleccionados = new Set();
    const sala3Form = document.getElementById('sala3Form');

    document.querySelectorAll('.skin-card').forEach(card => {
        card.addEventListener('click', function() {
            const skin = this.dataset.skin;
            const esCorrect = this.dataset.correcto === 'true';

            if (this.classList.contains('seleccionado')) {
                // Deseleccionar
                this.classList.remove('seleccionado');
                seleccionados.delete(skin);
                seleccionCount--;
            } else {
                if (!esCorrect) {
                    // Seleccionar incorrecto - mostrar error
                    alert('❌ ¡Eso no es correcto! Solo selecciona a Jonesy y Bananoide.');
                    return;
                }

                // Seleccionar correcto
                this.classList.add('seleccionado');
                seleccionados.add(skin);
                seleccionCount++;
            }

            document.getElementById('seleccionados').textContent = seleccionCount;

            // Si seleccionó los 2 correctos
            if (seleccionCount === 2 && seleccionados.has('jonesy') && seleccionados.has('bananoide')) {
                alert('🎉 ¡Encontraste los aliados correctos! ¡Avanzas a la siguiente sala!');
                sala3Form.submit();
            }
        });
    });
</script>
