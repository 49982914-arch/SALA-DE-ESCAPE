@{
    ViewData["Title"] = "Sala 3 - Laberinto";
}

<div class="sala3-maze-bg">
    <div class="container sala3-maze-container">
        <div class="text-center mb-4">
            <h1 class="sala3-maze-title">LABERINTO DE JONESY</h1>
            <p class="sala3-maze-subtitle">Sala 3 de 4 - Llega hasta el Bananoide sin caer en una pared.</p>
        </div>

        <div class="sala3-maze-panel">
            <div class="sala3-maze-status">
                <span class="sala3-maze-timer-label">TIEMPO</span>
                <span id="mazeTimer" class="sala3-maze-timer">01:30</span>
            </div>

            <canvas id="mazeCanvas" width="800" height="800" aria-label="Laberinto de Jonesy"></canvas>
            <p id="mazeMessage" class="sala3-maze-message">Usa las flechas del teclado para avanzar.</p>
        </div>
    </div>
</div>

<form id="sala3MazeForm" method="post" action="@Url.Action("Sala3", "Home")">
    <input type="hidden" name="respuesta" value="laberinto" />
</form>
