@{
    ViewData["Title"] = "Sala 2 - Midas & Renegada - La Tormenta Final";
}

<div class="row justify-content-center" style="min-height: 90vh; background: linear-gradient(135deg, #3d3d1a 0%, #2a1a0f 100%); padding: 30px 0; position: relative; overflow: hidden;">
    <div class="col-md-9">
        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4" style="position: relative; z-index: 10;">
            <div>
                <h2 style="color: #00d4ff; font-weight: bold;">💰 Midas & La Renegada</h2>
                <p style="color: #aaa; margin: 5px 0;">Sala 2 de 4 - Toca el oro</p>
            </div>
            <div style="background-color: #0f3460; padding: 15px 20px; border-radius: 8px;">
                <p style="color: #00d4ff; font-weight: bold; margin: 0;">⚡ PROGRESO</p>
                <div class="progress mt-2" style="height: 8px; background-color: #1a1a2e;">
                    <div class="progress-bar" role="progressbar" style="width: 50%; background-color: #00d4ff;"></div>
                </div>
            </div>
        </div>

        <!-- Tarjeta Principal -->
        <div class="card shadow-lg mb-4" style="background: linear-gradient(135deg, #1a1410 0%, #2a1810 100%); border: 2px solid #d4a500; border-radius: 15px; box-shadow: 0 0 20px rgba(212, 165, 0, 0.3);" id="mainCard">
            <div class="card-body p-5" style="position: relative; z-index: 5;">
                <!-- Instrucciones -->
                <div style="margin-bottom: 30px;">
                    <p style="color: #d4a500; font-size: 1.2rem; font-weight: bold; text-align: center; margin-bottom: 15px;">
                        🎯 ¡El botón dorado de Midas te espera!
                    </p>
                    <p style="color: #ccc; font-size: 1.05rem; text-align: center;">
                        Debes <strong style="color: #d4a500;">clickear el botón dorado 3 veces</strong> antes de que desaparezca.<br>
                        ¡Desafía el poder del oro legendario!
                    </p>
                    <div style="background-color: #0f3460; padding: 15px; border-radius: 8px; margin-top: 15px; border-left: 4px solid #d4a500;">
                        <p style="color: #00d4ff; margin: 0; font-weight: bold;">
                            Clicks restantes: <span id="clicksRestantes" style="color: #d4a500; font-size: 1.3rem;">3</span>
                        </p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;">
                        ❌ @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Formulario oculto -->
                <form method="post" action="@Url.Action("Sala2", "Home")" id="sala2Form" style="display: none;">
                    <input type="hidden" name="respuesta" value="dorado">
                </form>

                @if (ViewBag.Intentos > 0)
                {
                    <p style="color: #00d4ff; margin-top: 20px; text-align: center;">
                        📊 Intentos realizados: <strong>@ViewBag.Intentos</strong>
                    </p>
                }
            </div>
        </div>

        <!-- Zona de juego con el botón flotante -->
        <div style="background-color: #1a1a2e; border: 2px solid #d4a500; border-radius: 15px; padding: 40px; min-height: 300px; position: relative; overflow: hidden; box-shadow: 0 0 30px rgba(212, 165, 0, 0.2);">
            <button id="botonDorado" 
                    style="position: absolute; 
                           width: 80px; 
                           height: 80px; 
                           background: radial-gradient(circle at 30% 30%, #ffd700, #d4a500); 
                           border: 3px solid #ffed4e;
                           border-radius: 50%;
                           cursor: pointer; 
                           font-size: 2rem;
                           top: 50px; 
                           left: 50px; 
                           display: flex;
                           align-items: center;
                           justify-content: center;
                           box-shadow: 0 0 20px rgba(255, 215, 0, 0.8), inset 0 0 10px rgba(255, 255, 255, 0.3);
                           transition: all 0.1s;
                           z-index: 20;">
                💰
            </button>

            <p style="color: #666; text-align: center; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1rem; z-index: 1;">
                ¡Toca el botón dorado antes de que desaparezca!
            </p>
        </div>

        <!-- Pista -->
        <div style="background-color: #0f3460; border-left: 4px solid #d4a500; padding: 20px; border-radius: 8px; margin-top: 20px;">
            <p style="color: #00d4ff; font-weight: bold; margin: 0 0 10px 0;">💡 PISTA:</p>
            <p style="color: #ccc; margin: 0;">
                El botón cambia de posición cada 2 segundos. ¡Sé rápido y toca el oro antes de que se esfume!
            </p>
        </div>
    </div>
</div>

<script>
    let clicksRestantes = 3;
    let botonActivo = true;

    const botonDorado = document.getElementById('botonDorado');
    const clicksSpan = document.getElementById('clicksRestantes');
    const sala2Form = document.getElementById('sala2Form');

    function moverBotonaAleatorio() {
        if (!botonActivo) return;

        const maxX = window.innerWidth - 100;
        const maxY = window.innerHeight - 100;

        const randomX = Math.random() * maxX;
        const randomY = Math.random() * maxY;

        botonDorado.style.left = randomX + 'px';
        botonDorado.style.top = randomY + 'px';
    }

    function ocultarBoton() {
        botonDorado.style.opacity = '0.2';
        botonDorado.style.pointerEvents = 'none';

        setTimeout(() => {
            if (botonActivo) {
                botonDorado.style.opacity = '1';
                botonDorado.style.pointerEvents = 'auto';
                moverBotonaAleatorio();
            }
        }, 2000);
    }

    botonDorado.addEventListener('click', () => {
        if (!botonActivo) return;

        clicksRestantes--;
        clicksSpan.textContent = clicksRestantes;

        if (clicksRestantes === 0) {
            botonActivo = false;
            botonDorado.style.display = 'none';
            
            // Mostrar mensaje de victoria
            alert('🎉 ¡Tocaste el oro 3 veces! ¡Avanzas a la siguiente sala!');
            
            // Enviar formulario automáticamente
            sala2Form.submit();
        } else {
            moverBotonaAleatorio();
            ocultarBoton();
        }
    });

    // Iniciar el juego
    moverBotonaAleatorio();
    ocultarBoton();
</script>
