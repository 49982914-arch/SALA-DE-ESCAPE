@{
    ViewData["Title"] = "Sala 2 - Midas & Renegada - La Tormenta Final";
}

<audio id="audioTormenta" autoplay loop>
    <source src="/images/tormenta.m4a" type="audio/mp4">
</audio>

<div class="row justify-content-center sala2-container" style="min-height: 90vh; padding: 30px 0; position: relative; overflow: hidden;">
    <div class="col-md-9">
        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4 sala2-header">
            <div>
                <h2>💰 Midas & La Renegada</h2>
                <p>Sala 2 de 4 - Toca el oro</p>
            </div>
            <div class="sala2-progress-box">
                <p>⚡ PROGRESO</p>
                <div class="progress mt-2 sala2-progress-bar">
                    <div class="progress-bar sala2-progress-bar-fill" role="progressbar"></div>
                </div>
            </div>
        </div>

        <!-- Tarjeta Principal -->
        <div class="card shadow-lg mb-4 sala2-card">
            <div class="card-body sala2-card-body">
                <!-- Instrucciones -->
                <div class="sala2-instructions">
                    <p>🎯 ¡El botón dorado de Midas te espera!</p>
                    <p>
                        Debes <strong style="color: #d4a500;">clickear el botón dorado 10 veces</strong>.<br>
                        ¡Desafía el poder del oro legendario!
                    </p>
                    <div class="sala2-clicks-info">
                        <p>
                            Clicks restantes: <span id="clicksRestantes">10</span>
                        </p>
                        <p>
                            Tiempo: <span id="sala2Timer">15</span>s
                        </p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;">
                        ❌ @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Formulario oculto -->
                <form method="post" action="@Url.Action("Sala2", "Home")" id="sala2Form" style="display: none;">
                    <input type="hidden" name="respuesta" value="dorado">
                </form>

                @if (ViewBag.Intentos > 0)
                {
                    <p style="color: #00d4ff; margin-top: 20px; text-align: center;">
                        📊 Intentos realizados: <strong>@ViewBag.Intentos</strong>
                    </p>
                }
            </div>
        </div>

        <!-- Zona de juego con el botón flotante -->
        <div class="sala2-game-zone">
            <button id="botonDorado">💰</button>
            <p>¡Toca el botón dorado antes de que desaparezca!</p>
        </div>

        <!-- Pista -->
        <div class="sala2-hint">
            <p>💡 PISTA:</p>
            <p>
                El botón aparece y desaparece cada segundo. ¡Clickea 10 veces mientras está visible!
            </p>
        </div>
    </div>
</div>
