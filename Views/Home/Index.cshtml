@{
    ViewData["Title"] = "La Tormenta Final - Inicio";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
    <div class="col-md-6">
        <div class="card shadow-lg border-0" style="background-color: #0f3460; border-radius: 15px;">
            <div class="card-body p-5">
                <div class="text-center mb-5">
                    <h1 style="color: #00d4ff; font-weight: bold; font-size: 2.5rem; text-shadow: 0 0 10px #00d4ff;">
                        LA TORMENTA FINAL
                    </h1>
                    <p style="color: #e94560; font-size: 1.1rem; margin-top: 10px;">
                        🎮 Escape de la tempestad de Fortnite
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post" action="@Url.Action("Index", "Home")">
                    <div class="mb-4">
                        <label for="nombreParticipante" class="form-label" style="color: #00d4ff; font-weight: bold;">
                            ¿Cuál es tu apodo de batalla?
                        </label>
                        <input type="text" 
                               class="form-control form-control-lg" 
                               id="nombreParticipante" 
                               name="nombreParticipante" 
                               placeholder="Ingresa tu nombre..." 
                               required
                               style="background-color: #1a1a2e; color: #fff; border: 2px solid #00d4ff; border-radius: 8px;">
                    </div>

                    <button type="submit" class="btn btn-lg w-100" style="background-color: #00d4ff; color: #000; font-weight: bold; border-radius: 8px;">
                        🚀 COMENZAR ESCAPE
                    </button>
                </form>

                <div class="mt-5 pt-4 border-top border-secondary">
                    <p style="color: #aaa; font-size: 0.95rem; text-align: center; margin-bottom: 15px;">
                        <strong>Instrucciones:</strong>
                    </p>
                    <ul style="color: #ccc; font-size: 0.9rem; margin-bottom: 0;">
                        <li>Resuelve 4 acertijos para escapar</li>
                        <li>Cada sala tiene una respuesta única</li>
                        <li>Tienes intentos ilimitados</li>
                        <li>¡Que comience la aventura!</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        min-height: 100vh;
    }
</style>
